# Optional runtime assistance. Never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Set to assist only for a keyed runtime run; deterministic mode remains the default.
GHOST_AUDIT_LLM_MODE=assist
GHOST_AUDIT_VERIFY_USAGE=1
